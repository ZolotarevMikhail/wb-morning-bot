# Скопируйте этот файл в .env и вставьте свои значения.
# Реальный .env не попадает в git (см. .gitignore).

# Токен бота от @BotFather в Telegram
BOT_TOKEN=

# Токен API Wildberries (Настройки → Доступ к API; права: Статистика, Аналитика, Контент)
WB_TOKEN=

# Ключи Ozon (кабинет Ozon → Настройки → API-ключи). Необязательно:
# без них бот шлёт только WB-сводку, с ними — сразу по обеим площадкам.
OZON_CLIENT_ID=
OZON_API_KEY=